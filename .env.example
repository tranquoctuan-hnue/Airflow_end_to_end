# ═══════════════════════════════════════════════════════════════════════════════
# Cấu hình RIÊNG của từng máy. Tạo bản thật: cp .env.example .env  (không commit .env)
# start_airflow.sh nạp file này SAU các giá trị mặc định → mọi dòng ở đây ghi đè được.
# Dòng bắt đầu bằng # = đang dùng mặc định. Danh sách đầy đủ biến CRAWL_*:
# platform_crawlers/config.py (có giải thích từng biến).
# ═══════════════════════════════════════════════════════════════════════════════

# ── 1. Nơi lưu video (BẮT BUỘC xem lại trên máy mới) ─────────────────────────
# Mặc định là NAS pvn_share mount qua GVFS của máy gốc — máy khác gần như chắc chắn
# KHÔNG có. Đặt một thư mục trên ổ của máy này:
CRAWL_VIDEO_OUTPUT_DIR=/duong/dan/luu/video
# Video bị bộ lọc loại (mặc định: thư mục video_rejected cạnh CRAWL_VIDEO_OUTPUT_DIR)
# CRAWL_REJECTED_DIR=/duong/dan/luu/video_rejected
# move = giữ video bị loại để kiểm tra bộ lọc | delete = xóa luôn
# CRAWL_REJECT_ACTION=move

# ── 2. Model VideoMAE (bộ lọc sự việc) — xem models/README.md ───────────────
# Mặc định: models/Video_understanding/vitl_224x224_240926 trong dự án
# VIDEOMAE_MODEL_DIR=/duong/dan/vitl_224x224_240926
# Không có model / không có GPU → tắt bộ lọc này:
# SOCIAL_USE_VIDEOMAE=false

# ── 3. Bộ lọc CCTV (CLIP) — tắt nếu máy không có GPU ────────────────────────
# SOCIAL_USE_CLASSIFIER=true
# CRAWL_CCTV_CLASSIFIER=clip        # clip | qwen

# ── 4. Chọn platform / nhãn ─────────────────────────────────────────────────
# CRAWL_ENABLED_PLATFORMS=youtube|dailymotion|reddit|x|facebook
# CRAWL_LABELS=Arson|Robbery|Shooting        # trống = cả 27 nhãn (platform_crawlers/labels.py)

# ── 5. Reddit OAuth (không bắt buộc, nhưng nên có — xem .claude/skills/reddit-dag)
# Tạo app "script" tại https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=

# ── 6. Phiên đăng nhập platform — MỌI platform đăng nhập bằng Chrome ────────
# Đăng nhập X/Facebook/Reddit/Dailymotion trong Chrome thường; crawler tự lấy cookie
# và tự lấy lại khi phiên chết (platform_crawlers/sessions.py).
# COOKIE_BROWSER=chrome             # chrome | chromium | brave | edge | firefox
# COOKIE_PROFILE="Profile 3"        # chỉ lấy từ 1 profile (mặc định: quét mọi profile)
# COOKIE_KEYRING=GNOMEKEYRING       # mặc định tự chọn; KWALLET5/KWALLET6 nếu dùng KDE
# SESSION_CHECK=true                # false = không kiểm tra phiên đầu lượt crawl
# SESSION_NOTIFY_HOURS=12           # báo cùng 1 platform tối đa 1 lần / 12h
# Báo qua Telegram khi Chrome cũng hết đăng nhập (tạo bot với @BotFather, chat id lấy
# bằng https://api.telegram.org/bot<TOKEN>/getUpdates sau khi nhắn bot 1 tin):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# FB_HEADLESS=true                  # DAG cũ legacy_fb_groups_crawler

# ── RTSP (pipeline camera): tài khoản camera là Airflow Connection rtsp_cam_N (Admin →
# Connections). Chỉ khi chạy NGOÀI Airflow (script/test) mới đặt ở đây:
# RTSP_CRED_RTSP_CAM_1=admin:matkhau

# ── 7. Tinh chỉnh tốc độ (mặc định đã hợp lý cho GPU 6GB) ───────────────────
# CRAWL_TASK_TIME_BUDGET_MINUTES=60   # trần thời gian mỗi lượt của 1 platform
# CRAWL_MAX_PER_TARGET=100            # URL mỗi từ khóa
# CRAWL_MAX_PER_LABEL=25              # URL mỗi nhãn mỗi lượt
# VIDEOMAE_THRESHOLD=0.5
# VIDEOMAE_NUM_CROPS=1

# Gemini API key KHÔNG đặt ở đây: điền vào config/gemini_keys.json
# (mẫu: config/gemini_keys.example.json). Không có key → crawler
# dùng từ khóa tiếng Anh tĩnh trong platform_crawlers/labels.py.
